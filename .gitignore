.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.tmp
*.log
logs/
output/
backup/
finance.db
finance.db-*

# Local user reference data; only empty templates belong in Git.
config/categories.xlsx
config/own_accounts.xlsx

# Private banking sources and extracted text must never be published.
input/*
!input/.gitkeep
archive/**
!archive/statements/
!archive/statements/.gitkeep

# Any local SQLite database is private; keep only the synthetic legacy fixture.
*.db
*.db-*
!tests/fixtures/legacy_stage2_synthetic.db

# Private classification rules; publish only empty templates.
rules/*.json
!rules/*.template.json
